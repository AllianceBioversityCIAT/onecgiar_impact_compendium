{
  "name": "impact-compendium-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:auth": "playwright test tests/suites/authentication.spec.ts",
    "test:dashboard": "playwright test tests/suites/dashboard.spec.ts",
    "test:studies": "playwright test tests/suites/studies.spec.ts",
    "test:responsive": "playwright test tests/suites/responsive.spec.ts",
    "test:performance": "playwright test tests/suites/performance.spec.ts",
    "test:full-suite": "playwright test tests/run-all-tests.ts",
    "test:components": "node tests/test-all-components.cjs",
    "test:auth-scenario": "node tests/scenarios/authentication/auth-test.cjs",
    "test:dashboard-scenario": "node tests/scenarios/dashboard/dashboard-test.cjs",
    "test:studies-scenario": "node tests/scenarios/studies/studies-test.cjs",
    "test:authenticated": "node tests/scenarios/authenticated-test.cjs",
    "test:report": "playwright show-report test-results/html-report",
    "test:clean": "rm -rf test-results && mkdir -p test-results/screenshots"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.13.1",
    "aws-amplify": "^6.15.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
